APP_NAME="Crawl4AI Enhancer"
APP_ID=crawl4ai-enhancer
DATA_DIR=/data
DB_URL=sqlite:////data/app.db
UPSTREAM_BASE_URL=http://localhost:11235
UPSTREAM_AUTH_HEADER=
UPSTREAM_DEFAULT_TIMEOUT_SECONDS=300

# Optional: path to YAML/JSON listing multiple Crawl4AI upstreams (spray/balancer roadmap).
# Fields: name (unique), group (region/cluster), url, auth_header, weight (default 1), timeout_seconds (optional).
# Leave empty to use UPSTREAM_BASE_URL only. When set, UPSTREAM_BASE_URL must be unset
# and the first upstream entry is used (until the balancer is implemented); upstream auth defaults to the per-entry auth_header.
# Example: UPSTREAMS_FILE=./upstreams.example.yaml
UPSTREAMS_FILE=

# Image pull settings for docker-compose.yml
IMAGE_REGISTRY=ghcr.io
IMAGE_OWNER=dpalic
IMAGE_NAME=crawl4ai-enhancer
IMAGE_TAG=latest
PORT=11234
